{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Home Assistant (Development Mode)",
      "type": "shell",
      "command": "./script/develop",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Run Home Assistant (Environment)",
      "type": "shell",
      "command": "./script/develop --env ${input:haEnvironment} --force",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Switch Home Assistant Environment",
      "type": "shell",
      "command": "./script/ha-env use ${input:haEnvironment}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Add Home Assistant Environment",
      "type": "shell",
      "command": "./script/ha-env add ${input:haOptionalEnvironment}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Pin Home Assistant Version (custom Environment)",
      "type": "shell",
      "command": "./script/ha-env add custom ${input:haCustomVersion}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Refresh Home Assistant Environments",
      "type": "shell",
      "command": "./script/ha-env refresh",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "./script/test -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Changed Tests",
      "type": "shell",
      "command": "./script/test -v --picked",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Update Test Snapshots",
      "type": "shell",
      "command": "./script/test --snapshot-update",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests with Coverage",
      "type": "shell",
      "command": "./script/test --cov-html",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint (Ruff Format + Check)",
      "type": "shell",
      "command": "./script/lint",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint Check (Read-Only)",
      "type": "shell",
      "command": "./script/lint-check",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Pre-commit (All Hooks)",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Requirements",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements.txt",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Dev Requirements",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements_dev.txt",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Test Requirements",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements_test.txt",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean Cache",
      "type": "shell",
      "command": "./script/clean",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean Cache (Deep)",
      "type": "shell",
      "command": "./script/clean --deep",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "./script/type-check",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Check All (Type + Lint)",
      "type": "shell",
      "command": "./script/check",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Validate Manifest",
      "type": "shell",
      "command": "bash -c 'source script/.lib/integration.sh && jq -e objects \"$INTEGRATION_PATH/manifest.json\" >/dev/null && echo \"✅ manifest.json is valid\"'",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "haEnvironment",
      "type": "pickString",
      "description": "Home Assistant environment to switch to",
      "options": ["minimum", "latest", "beta", "custom"],
      "default": "minimum"
    },
    {
      "id": "haOptionalEnvironment",
      "type": "pickString",
      "description": "Home Assistant environment to install",
      "options": ["latest", "beta"],
      "default": "beta"
    },
    {
      "id": "haCustomVersion",
      "type": "promptString",
      "description": "Home Assistant version for the custom environment, from the hacs.json minimum on (e.g. 2026.11.1 or 2026.12.0b3)"
    }
  ]
}
