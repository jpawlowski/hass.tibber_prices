#!/usr/bin/env bash
# Build the user documentation site

set -e

# Find repository root (where .git directory is)
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT" || exit 1

echo "🔨 Building User Documentation..."
cd docs/user
npm run build
cd ../..

echo ""
echo "✅ User documentation built: docs/user/build/"
