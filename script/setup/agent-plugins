#!/bin/bash

# script/setup/agent-plugins: Install the agent plugins this repository enables, at the version it pins
#
# Reads the pinned marketplace and the enabled plugins from .claude/settings.json, checks that
# .github/copilot/settings.json and .codex/config.toml say the same, and installs them for the agent CLIs on PATH.
# Run by script/setup/bootstrap; INSTALL_AGENT_PLUGINS=0 skips the install, never the check.
#
# Usage:
#   ./script/setup/agent-plugins [--check]
#
# Examples:
#   ./script/setup/agent-plugins          # Check, then install
#   ./script/setup/agent-plugins --check  # Only check that the three settings files agree

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/../.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/../.lib/output.sh"

run_hook "setup/agent-plugins" "pre"

args=("$@")
if [[ ${INSTALL_AGENT_PLUGINS:-"1"} == "0" ]]; then
    log_info "INSTALL_AGENT_PLUGINS=0: checking only"
    args=(--check)
fi

python3 "$SCRIPT_DIR/../.lib/agent_plugins.py" "${args[@]}"

run_hook "setup/agent-plugins" "post"
