#!/bin/bash

# script/ha-version-sync: Validate HA release-train consistency across all version sources
#
# Checks that pytest-homeassistant (requirements_test.txt),
# the homeassistant minimum in hacs.json, and HA_VERSION in .devcontainer/.env
# (when explicitly set) all target the same Home Assistant release train (YYYY.M).
# Also checks that the Python version mise.toml pins satisfies the requires-python of
# pyproject.toml and of the Home Assistant release that pin pulls in.
# Also ensures CI workflows do not hardcode HA_VERSION pins, which could drift from
# the canonical sources above.
#
# Exits non-zero when a mismatch is detected so that pre-commit and CI jobs can
# surface the inconsistency before it reaches the main branch.
#
# Usage:
#   ./script/ha-version-sync
#
# Called automatically by the pre-commit ha-version-sync hook and the
# ha-version-sync-check GitHub Actions workflow.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

python3 <<'PY'
import importlib.metadata
import json
import os
import re
import sys
import urllib.request
from pathlib import Path


def fail(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    raise SystemExit(1)


def warn(msg: str) -> None:
    print(f"WARNING: {msg}", file=sys.stderr)


def pypi_info(package: str, version: str) -> dict | None:
    """Return the PyPI metadata of one release, or None after a warning when PyPI cannot be reached.

    An unreachable PyPI says nothing about whether this repository's versions agree, so the caller skips the one check
    that needs it rather than blocking a commit. Only an unusable reply stays fatal, since that is structural.
    """
    base = os.environ.get("HA_VERSION_SYNC_PYPI_URL", "https://pypi.org/pypi")
    try:
        with urllib.request.urlopen(f"{base}/{package}/{version}/json", timeout=15) as resp:
            return json.loads(resp.read().decode("utf-8")).get("info", {})
    except (OSError, ValueError) as err:
        warn(f"Could not reach PyPI for {package}=={version} ({err}) - skipping the check that needs it")
        return None


def ha_requires_python(version: str) -> str | None:
    """Return the requires-python of a Home Assistant release, from the installed one when it is that release."""
    try:
        if importlib.metadata.version("homeassistant") == version:
            return importlib.metadata.metadata("homeassistant").get("Requires-Python", "")
    except importlib.metadata.PackageNotFoundError:
        pass
    info = pypi_info("homeassistant", version)
    return None if info is None else info.get("requires_python") or ""


def release_train(version: str) -> str:
    """Return YYYY.M from any HA version string (stable, pre-release, or train-only)."""
    parts = version.split(".")
    return f"{parts[0]}.{parts[1]}" if len(parts) >= 2 else version  # noqa: SIM210


def assert_no_hardcoded_ha_version(path: str) -> None:
    """Fail when a workflow file contains a hardcoded numeric HA_VERSION assignment."""
    text = Path(path).read_text(encoding="utf-8")
    pinned_patterns = (
        r"\bHA_VERSION\s*=\s*\"?\d{4}\.\d+(?:\.\d+)?(?:[ab]\d+|rc\d+)?\"?",
        r"\bHA_VERSION\s*:\s*\"?\d{4}\.\d+(?:\.\d+)?(?:[ab]\d+|rc\d+)?\"?",
    )
    for pattern in pinned_patterns:
        if re.search(pattern, text):
            fail(
                f"{path} contains a hardcoded HA_VERSION pin. "
                "Read the value from hacs.json instead."
            )


# ── pytest-homeassistant ─────────────────────────────────────────────────────
# Each release carries the version of the Home Assistant release it pins, so the pin names the version itself; a
# repackaging suffix (.post1, .dev1) is the plugin's own.
req_text = Path("requirements_test.txt").read_text(encoding="utf-8")
pytest_ha: str | None = None
if m := re.search(r"^pytest-homeassistant==([^\s#]+)", req_text, re.MULTILINE):
    pytest_ha = re.sub(r"\.(post|dev)\d+$", "", m.group(1))
    pin = f"pytest-homeassistant=={m.group(1)}"
elif m := re.search(r"^pytest-homeassistant-custom-component==([^\s#]+)", req_text, re.MULTILINE):
    # The predecessor, which a project below Home Assistant 2026.11 keeps; only PyPI knows which release it pins.
    pin = f"pytest-homeassistant-custom-component=={m.group(1)}"
    if (info := pypi_info("pytest-homeassistant-custom-component", m.group(1))) is not None:
        requires = info.get("requires_dist") or []
        ha_req = next((r for r in requires if r.startswith("homeassistant==")), None)
        if ha_req is None:
            fail(f"Could not determine the Home Assistant dependency of {pin}")
        pytest_ha = ha_req.split("==", 1)[1].strip()
else:
    fail("pytest-homeassistant pin not found in requirements_test.txt")

# ── hacs.json ────────────────────────────────────────────────────────────────
hacs = json.loads(Path("hacs.json").read_text(encoding="utf-8"))
hacs_ha = str(hacs.get("homeassistant", "")).strip()
if not hacs_ha:
    fail("hacs.json does not contain a valid 'homeassistant' value")
hacs_train = release_train(hacs_ha)

# ── HA_VERSION from .devcontainer/.env (project-level, committed) ─────────────
# .env.local is intentionally excluded: it is gitignored and cannot be checked
# consistently across all environments (local dev, CI, pre-commit).
# Symbolic values ("latest", "beta") cannot be resolved to a fixed train without
# a full PyPI lookup, so they are skipped — they represent intentional "run ahead"
# scenarios that do not require the other sources to be updated.
env_ha: str | None = None
env_file = Path(".devcontainer/.env")
if env_file.exists():
    em = re.search(r"^HA_VERSION\s*=\s*([^\s#]+)", env_file.read_text(encoding="utf-8"), re.MULTILINE)
    if em:
        v = em.group(1).strip()
        if v not in ("latest", "beta"):
            env_ha = v

# ── Workflow guards ───────────────────────────────────────────────────────────
# Keep workflows aligned by disallowing hardcoded HA_VERSION values there.
for workflow_file in sorted(Path(".github/workflows").glob("*.yml")):
    assert_no_hardcoded_ha_version(str(workflow_file))

# ── Compare all sources ───────────────────────────────────────────────────────
# Map: display-name → (full version, release train)
sources: dict[str, tuple[str, str]] = {}
if pytest_ha is not None:
    sources[pin] = (pytest_ha, release_train(pytest_ha))
sources["hacs.json homeassistant"] = (hacs_ha, hacs_train)
if env_ha is not None:
    sources[".devcontainer/.env HA_VERSION"] = (env_ha, release_train(env_ha))

unique_trains = {t for _, t in sources.values()}
if len(unique_trains) > 1:
    lines = "\n".join(f"  {name}: {ver} (train {t})" for name, (ver, t) in sources.items())
    print(
        f"HA version sync FAILED — release train mismatch:\n{lines}\n\n"
        "Update hacs.json, requirements_test.txt, and .devcontainer/.env together. "
        "If CI workflows were edited, avoid hardcoded HA_VERSION values there.",
        file=sys.stderr,
    )
    raise SystemExit(1)

# ── Python from mise.toml ────────────────────────────────────────────────────
def version_tuple(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in re.findall(r"\d+", version)[:3])


mise_file = Path("mise.toml")
mise_python = None
if mise_file.exists():
    pm = re.search(r'^python\s*=\s*"([^"]+)"', mise_file.read_text(encoding="utf-8"), re.MULTILINE)
    if pm:
        mise_python = pm.group(1)

python_minimums: dict[str, str] = {}
rm = re.search(r'^requires-python\s*=\s*">=\s*([^",]+)', Path("pyproject.toml").read_text(encoding="utf-8"), re.MULTILINE)
if rm:
    python_minimums["pyproject.toml requires-python"] = rm.group(1).strip()
if pytest_ha is not None and (ha_requires := ha_requires_python(pytest_ha)):
    if hm := re.search(r">=\s*([0-9.]+)", ha_requires):
        python_minimums[f"homeassistant=={pytest_ha} requires-python"] = hm.group(1)

if mise_python is not None:
    pinned = version_tuple(mise_python)
    if not pinned:
        fail(f"mise.toml pins python {mise_python!r}, which names no version to check against requires-python")
    for name, minimum in python_minimums.items():
        if pinned < version_tuple(minimum)[: len(pinned)]:
            fail(f"mise.toml pins python {mise_python}, but {name} needs >={minimum}")

print("HA version sync OK:")
for name, (ver, t) in sources.items():
    print(f"  {name}: {ver} (train {t})")
if mise_python is not None:
    print(f"  mise.toml python: {mise_python} (needs {', '.join(f'>={m}' for m in python_minimums.values()) or 'nothing'})")
PY
