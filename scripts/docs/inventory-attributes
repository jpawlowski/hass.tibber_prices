#!/usr/bin/env python3
"""
Inventory of the state attributes the entities can emit (input for translating attribute names, #267).

Static scan, no Home Assistant needed. Two sources, cross-checked:
  1. TypedDict fields in sensor/types.py and binary_sensor/types.py (documented attribute keys per type)
  2. String keys written in the attribute builders (subscript assignment, dict literals, f-string keys)

Prints a markdown table: key, flags (dynamic / undocumented / types-only) and how often it was found.
Usage: scripts/docs/inventory-attributes [--json]
"""

from __future__ import annotations

import ast
from collections import defaultdict
import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2] / "custom_components" / "tibber_prices"
TYPE_FILES = [ROOT / "sensor" / "types.py", ROOT / "binary_sensor" / "types.py"]
BUILDER_FILES = [
    *sorted((ROOT / "sensor" / "attributes").glob("*.py")),
    ROOT / "binary_sensor" / "attributes.py",
    ROOT / "sensor" / "chart_metadata.py",
    ROOT / "sensor" / "calculators" / "trend.py",
    ROOT / "sensor" / "calculators" / "volatility.py",
    ROOT / "utils" / "trend.py",
    *sorted((ROOT / "coordinator" / "period_handlers").glob("*.py")),
]
KEY = re.compile(r"^[A-Za-z][A-Za-z0-9_{}]*$")


def rel(path: Path) -> str:
    """Return a path relative to the integration."""
    return str(path.relative_to(ROOT))


def fstring_key(node: ast.JoinedStr) -> str:
    """Render an f-string key with its placeholders as {name}."""
    out = []
    for part in node.values:
        if isinstance(part, ast.Constant):
            out.append(str(part.value))
        elif isinstance(part, ast.FormattedValue):
            name = part.value.id if isinstance(part.value, ast.Name) else "x"
            out.append("{" + name + "}")
    return "".join(out)


def typed_dict_keys() -> dict[str, set[str]]:
    """Collect the TypedDict fields (documented attribute keys) with where they are declared."""
    keys: dict[str, set[str]] = defaultdict(set)
    for path in TYPE_FILES:
        tree = ast.parse(path.read_text(encoding="utf-8"))
        for cls in (n for n in ast.walk(tree) if isinstance(n, ast.ClassDef)):
            for stmt in cls.body:
                if isinstance(stmt, ast.AnnAssign) and isinstance(stmt.target, ast.Name):
                    keys[stmt.target.id].add(f"{rel(path)}:{cls.name}")
    return keys


def builder_keys() -> dict[str, set[str]]:
    """Collect the string keys the attribute builders write, with file and line."""
    keys: dict[str, set[str]] = defaultdict(set)

    def add(name: str, path: Path, line: int) -> None:
        if KEY.match(name):
            keys[name].add(f"{rel(path)}:{line}")

    for path in BUILDER_FILES:
        tree = ast.parse(path.read_text(encoding="utf-8"))
        for node in ast.walk(tree):
            if isinstance(node, ast.Subscript) and isinstance(node.ctx, ast.Store):
                sl = node.slice
                if isinstance(sl, ast.Constant) and isinstance(sl.value, str):
                    add(sl.value, path, node.lineno)
                elif isinstance(sl, ast.JoinedStr):
                    add(fstring_key(sl), path, node.lineno)
            elif isinstance(node, ast.Dict):
                for k in node.keys:
                    if isinstance(k, ast.Constant) and isinstance(k.value, str):
                        add(k.value, path, k.lineno)
                    elif isinstance(k, ast.JoinedStr):
                        add(fstring_key(k), path, k.lineno)
    return keys


def main() -> None:
    """Print the inventory as a markdown table, or as JSON with --json."""
    documented = typed_dict_keys()
    written = builder_keys()
    rows = []
    for key in sorted(set(documented) | set(written)):
        flags = []
        if "{" in key:
            flags.append("dynamic")
        if key not in documented:
            flags.append("undocumented")
        if key not in written:
            flags.append("types-only")
        rows.append(
            {
                "key": key,
                "flags": flags,
                "types": sorted(documented.get(key, [])),
                "writes": sorted(written.get(key, [])),
            }
        )
    if "--json" in sys.argv:
        sys.stdout.write(json.dumps(rows, indent=2) + "\n")
        return
    lines = [
        f"{len(rows)} keys\n",
        "| key | flags | documented (count) | written (count) |",
        "| --- | --- | --- | --- |",
        *(f"| `{r['key']}` | {', '.join(r['flags'])} | {len(r['types'])} | {len(r['writes'])} |" for r in rows),
    ]
    sys.stdout.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
