#!/bin/bash

# scripts/setup/update-ha-version: Update Home Assistant version across dev environment
#
# Checks that the pytest-homeassistant release for the given HA version exists
# (same version number, Home Assistant's own test package) and updates scripts/setup/bootstrap and
# requirements.txt atomically, plus .python-version to the Python that HA version
# is built on. This is the single command to run when upgrading
# the development environment to a new Home Assistant version.
#
# Usage:
#   ./scripts/setup/update-ha-version VERSION
#
# Examples:
#   ./scripts/setup/update-ha-version 2026.5.4
#   ./scripts/setup/update-ha-version 2026.6.0b0

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/../.."

# shellcheck source=scripts/.lib/output.sh
source "$SCRIPT_DIR/../.lib/output.sh"

BOOTSTRAP_FILE="scripts/setup/bootstrap"
REQUIREMENTS_FILE="requirements.txt"
PYTHON_VERSION_FILE=".python-version"

# --- Argument validation ---
if [[ $# -ne 1 ]]; then
    log_error "Usage: $0 VERSION (e.g. 2026.5.4 or 2026.6.0b0)"
    exit 1
fi
NEW_HA_VERSION="$1"

# --- Read current versions from files ---
CURRENT_HA_VERSION=$(grep -oP 'HA_VERSION:-"\K[^"]+' "$BOOTSTRAP_FILE")
CURRENT_TEST_VERSION=$(grep -oP 'pytest-homeassistant==\K\S+' "$REQUIREMENTS_FILE")

log_header "Updating Home Assistant version"
log_info "Current: homeassistant==${CURRENT_HA_VERSION} / pytest-homeassistant==${CURRENT_TEST_VERSION}"
log_info "Target:  homeassistant==${NEW_HA_VERSION}"
echo

if [[ "$NEW_HA_VERSION" == "$CURRENT_HA_VERSION" ]]; then
    log_warning "Already on homeassistant==${NEW_HA_VERSION}, nothing to do."
    exit 0
fi

# --- Check that the matching pytest-homeassistant release exists ---
# pytest-homeassistant is Home Assistant's own test package (it replaced
# pytest-homeassistant-custom-component): its version IS the HA version, so there
# is nothing to look up, only to check that it was published already.
log_step "Checking PyPI for pytest-homeassistant==${NEW_HA_VERSION}..."
if ! curl -fsS -o /dev/null "https://pypi.org/pypi/pytest-homeassistant/${NEW_HA_VERSION}/json"; then
    log_error "No pytest-homeassistant release for homeassistant==${NEW_HA_VERSION}"
    log_info "Check https://pypi.org/pypi/pytest-homeassistant/json for available versions"
    exit 1
fi

log_result 0 "pytest-homeassistant==${NEW_HA_VERSION}"
echo

# --- Find the Python version of that HA version ---
log_step "Reading the Python version of Home Assistant ${NEW_HA_VERSION}..."
HA_CORE_BASE_URL="https://raw.githubusercontent.com/home-assistant/core/${NEW_HA_VERSION}"
# Major.minor only: any patch release of it will do
if HA_PYTHON_VERSION=$(curl -fsSL "${HA_CORE_BASE_URL}/.python-version" 2>/dev/null); then
    NEW_PYTHON_VERSION=$(echo "$HA_PYTHON_VERSION" | grep -oE '^[0-9]+\.[0-9]+' || true)
else
    # Older HA versions have no .python-version: newest Python they declare.
    # Classifiers can run ahead of what the release supports, so say where it came from.
    log_warning "No .python-version in Home Assistant ${NEW_HA_VERSION}, falling back to the classifiers in its pyproject.toml"
    if ! HA_PYPROJECT=$(curl -fsSL "${HA_CORE_BASE_URL}/pyproject.toml" 2>/dev/null); then
        log_error "Could not download ${HA_CORE_BASE_URL}/pyproject.toml"
        exit 1
    fi
    NEW_PYTHON_VERSION=$(echo "$HA_PYPROJECT" |
        grep -oP 'Programming Language :: Python :: \K[0-9]+\.[0-9]+' | sort -V | tail -n 1 || true)
fi
if [[ -z $NEW_PYTHON_VERSION ]]; then
    log_error "Could not determine the Python version of Home Assistant ${NEW_HA_VERSION}"
    exit 1
fi
CURRENT_PYTHON_VERSION=$(<"$PYTHON_VERSION_FILE")
log_result 0 "Python ${NEW_PYTHON_VERSION}"
echo

# --- Apply changes ---
log_step "Updating ${BOOTSTRAP_FILE}..."
sed -i "s/HA_VERSION:-\"${CURRENT_HA_VERSION}\"/HA_VERSION:-\"${NEW_HA_VERSION}\"/" "$BOOTSTRAP_FILE"

log_step "Updating ${REQUIREMENTS_FILE}..."
sed -i "s/pytest-homeassistant==${CURRENT_TEST_VERSION}/pytest-homeassistant==${NEW_HA_VERSION}/" "$REQUIREMENTS_FILE"

log_step "Updating ${PYTHON_VERSION_FILE}..."
echo "$NEW_PYTHON_VERSION" >"$PYTHON_VERSION_FILE"

# --- Summary ---
echo
log_success "Done! Updated to:"
log_info "  homeassistant==${NEW_HA_VERSION}  (in ${BOOTSTRAP_FILE})"
log_info "  pytest-homeassistant==${NEW_HA_VERSION}  (in ${REQUIREMENTS_FILE})"
log_info "  Python ${NEW_PYTHON_VERSION}  (in ${PYTHON_VERSION_FILE})"
if [[ "$NEW_PYTHON_VERSION" != "$CURRENT_PYTHON_VERSION" ]]; then
    log_warning "Python changes from ${CURRENT_PYTHON_VERSION} to ${NEW_PYTHON_VERSION}: check requires-python in pyproject.toml"
fi
echo
log_info "Next steps:"
log_info "  1. Rebuild the DevContainer to apply the new environment"
log_info "  2. Run ./scripts/test to verify the test suite still passes"
