#!/usr/bin/env python3
"""
Generate the translated attribute names (`state_attributes`) of the entities.

Home Assistant shows an attribute's name in the more-info dialog from
`entity.<platform>.<translation_key>.state_attributes.<attribute>.name` of the
integration's `translations/<language>.json`, one entry per entity. Writing
those by hand for every entity and language drifts, so they are generated from
one source, `scripts/i18n/attribute-names.json` (not shipped with the integration):

- `names`: attribute -> [en, de, nb, nl, sv] (language order as in `languages`).
  A `{h}` in the attribute and in the texts stands for an hour count taken from the
  entity's own key (`price_outlook_4h` -> `trend_4h_percent`, "next 4 h").
- `groups`: which entities have which attributes: `platform` (or `*`), a regex (searched, anchor with ^) on the
  entity's translation key (named group `h` for the hour count) and the attributes.

Attribute keys must match `[a-z0-9_-]` (Hassfest). An attribute an entity doesn't
have costs nothing but a string, so a group may list more than is always present.

Usage:
    scripts/i18n/generate-attribute-translations           # write translations/*.json
    scripts/i18n/generate-attribute-translations --check   # fail if they are out of date (CI)
"""

from __future__ import annotations

import json
from pathlib import Path
import re
import sys

REPO = Path(__file__).resolve().parents[2]
SOURCE = REPO / "scripts" / "i18n" / "attribute-names.json"
TRANSLATIONS = REPO / "custom_components" / "tibber_prices" / "translations"
KEY = re.compile(r"^[a-z0-9_-]+$")


def load_source() -> dict:
    """Read the source and check that every name has a text per language."""
    source = json.loads(SOURCE.read_text(encoding="utf-8"))
    languages = source["languages"]
    for attribute, texts in source["names"].items():
        if len(texts) != len(languages):
            sys.exit(f"{attribute}: {len(texts)} texts for {len(languages)} languages")
    return source


def attributes_of(source: dict, platform: str, entity: str) -> dict[str, tuple[str, str]]:
    """Return the entity's attributes as key -> (name template, hour count), expanded and in group order."""
    found: dict[str, tuple[str, str]] = {}
    for group in source["groups"]:
        if group["platform"] in ("*", platform) and (match := re.search(group["match"], entity)):
            hours = match.groupdict().get("h") or ""
            for template in group["attributes"]:
                if "{h}" in template and not hours:
                    sys.exit(
                        f"{platform}.{entity}: {template!r} needs a (?P<h>...) group in the regex {group['match']!r}"
                    )
                found.setdefault(template.replace("{h}", hours), (template, hours))
    return found


def build(source: dict) -> dict[str, str]:
    """Return the new content of every translations file, keyed by language."""
    english = json.loads((TRANSLATIONS / "en.json").read_text(encoding="utf-8"))["entity"]
    names = source["names"]
    used: set[str] = set()
    plan: dict[tuple[str, str], dict[str, tuple[str, str]]] = {}
    for platform, entities in english.items():
        for entity in entities:
            attributes = attributes_of(source, platform, entity)
            for key, (template, hours) in attributes.items():
                if not KEY.match(key):
                    sys.exit(f"{platform}.{entity}: invalid attribute key {key!r}")
                if template not in names:
                    sys.exit(f"{platform}.{entity}: no name for attribute {template!r}")
                for text in names[template]:
                    if "{" in text.replace("{h}", hours):
                        sys.exit(f"{platform}.{entity}.{key}: unresolved placeholder in {text!r}")
                used.add(template)
            plan[platform, entity] = attributes
    if unused := [template for template in names if template not in used]:
        sys.exit(f"Names no entity uses (remove them or add a group): {', '.join(unused)}")

    result: dict[str, str] = {}
    for index, language in enumerate(source["languages"]):
        raw = (TRANSLATIONS / f"{language}.json").read_text(encoding="utf-8")
        data = json.loads(raw)
        for (platform, entity), attributes in plan.items():
            target = data["entity"][platform][entity]
            target.pop("state_attributes", None)
            if attributes:
                target["state_attributes"] = {
                    key: {"name": names[template][index].replace("{h}", hours)}
                    for key, (template, hours) in attributes.items()
                }
        result[language] = json.dumps(data, indent=2, ensure_ascii=False) + ("\n" if raw.endswith("\n") else "")
    return result


def main() -> None:
    """Write the translations, or with --check only compare them."""
    new = build(load_source())
    stale = [lang for lang, text in new.items() if (TRANSLATIONS / f"{lang}.json").read_text(encoding="utf-8") != text]
    if "--check" in sys.argv:
        if stale:
            sys.exit(
                f"Attribute translations out of date ({', '.join(stale)}): run scripts/i18n/generate-attribute-translations"
            )
        sys.stdout.write("Attribute translations are up to date\n")
        return
    for lang in stale:
        (TRANSLATIONS / f"{lang}.json").write_text(new[lang], encoding="utf-8")
    sys.stdout.write(f"Updated: {', '.join(stale) if stale else 'nothing to do'}\n")


if __name__ == "__main__":
    main()
