#!/bin/bash

# scripts/release/build-asset: Build the release asset the store installs
#
# Packs custom_components/tibber_prices/ of a tag into the zip named in that tag's
# hacs.json (zip_release + filename), with the integration at the zip root, and
# checks the layout the store needs.
#
# The version in manifest.json must be the tag's: it is also part of the cards' URL
# (frontend/__init__.py), so browsers fetch them anew after an update. For a release
# release-please wrote it into the tagged commit, and this only checks it. A beta
# tag (vX.Y.ZbN) is pushed by hand on a commit whose manifest still carries the last
# release, so for a beta the version is written into the zip's copy.
#
# Home Assistant serves the cards uncompressed, but aiohttp sends a file's .gz
# copy instead when the browser accepts gzip. So every card module gets one here:
# about 200 KB instead of 700 KB on a cold cache. Only in the zip: in the
# repository a stale copy would hide every edit of its module.
#
# Runs in CI (release.yml, job "build", read-only token; it uploads what lands
# in OUTPUT_DIR) and locally, to see what a release would ship. Build steps for
# the asset go between unpacking and zipping, and run nothing from a package
# registry: gzip ships with the system.
#
# Usage:
#   ./scripts/release/build-asset TAG [OUTPUT_DIR]
#
# Examples:
#   ./scripts/release/build-asset v0.40.0          # writes ./tibber_prices.zip
#   ./scripts/release/build-asset v0.40.0b0 dist   # writes dist/tibber_prices.zip
#
# Prints the path of the zip on stdout.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# OUTPUT_DIR is relative to where the script was called from, not to the repository root
CALLER_DIR="$PWD"
cd "$SCRIPT_DIR/../.."

# shellcheck source=scripts/.lib/output.sh
source "$SCRIPT_DIR/../.lib/output.sh"

TAG="${1:-}"
OUTPUT_DIR="${2:-.}"
[[ $OUTPUT_DIR == /* ]] || OUTPUT_DIR="$CALLER_DIR/$OUTPUT_DIR"
INTEGRATION="custom_components/tibber_prices"

[[ -n $TAG ]] || die "No tag given.\n\nUsage: $0 TAG [OUTPUT_DIR]"
require_command "jq" "apt-get install jq"
require_command "zip" "apt-get install zip"
require_command "unzip" "apt-get install unzip"

VERSION="${TAG#v}"
[[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+(b[0-9]+)?$ ]] || die "$TAG is not vX.Y.Z or vX.Y.ZbN"
git rev-parse --verify --quiet "refs/tags/${TAG}" >/dev/null || die "Tag $TAG does not exist"

# The file name comes from hacs.json of the tag, the one place the store reads it from: a second
# copy here could drift and ship an asset under a name the store never asks for (404 on install)
FILENAME=$(git show "refs/tags/${TAG}:hacs.json" | jq -er '.filename') ||
    die "hacs.json at $TAG has no filename (zip_release needs one)"

BUILD=$(mktemp -d)
trap 'rm -rf "$BUILD"' EXIT

# From the tag, not the working tree: main may be ahead of it. git archive packs tracked files only.
git archive --format=tar "refs/tags/${TAG}:${INTEGRATION}" | tar -x -C "$BUILD"

if [[ $VERSION == *b* ]]; then
    # The copy is thrown away after zipping, so jq may reformat it
    jq --arg version "$VERSION" '.version = $version' "$BUILD/manifest.json" >"$BUILD/manifest.json.new"
    mv "$BUILD/manifest.json.new" "$BUILD/manifest.json"
else
    MANIFEST_VERSION=$(jq -r '.version' "$BUILD/manifest.json")
    [[ $MANIFEST_VERSION == "$VERSION" ]] ||
        die "manifest.json at $TAG says $MANIFEST_VERSION, not $VERSION: release-please's extra-files didn't update it"
fi

# -n leaves name and time out of the copy, so the same module gives the same bytes; -k keeps the
# module itself for browsers that don't accept gzip
CARDS="$BUILD/frontend/cards"
find "$CARDS" -maxdepth 1 -name '*.js' -exec gzip -9 -k -n {} +

mkdir -p "$OUTPUT_DIR"
OUTPUT="$(cd "$OUTPUT_DIR" && pwd)/$FILENAME"
rm -f "$OUTPUT"
(cd "$BUILD" && zip -q -r -X "$OUTPUT" .)

# A zip with a wrong layout breaks the install for every user: check what the store needs
[[ "$(unzip -p "$OUTPUT" manifest.json | jq -r '.version')" == "$VERSION" ]] ||
    die "$FILENAME has no manifest.json at its root with version $VERSION"
ENTRIES=$(unzip -Z1 "$OUTPUT")
for required in __init__.py frontend/cards/tibber-prices-cards.js; do
    grep -qxF "$required" <<<"$ENTRIES" || die "$FILENAME lacks $required"
done
# A module without its copy would go out uncompressed, a copy without its module would never be
# asked for
MODULES=$(grep -cE '^frontend/cards/[^/]+\.js$' <<<"$ENTRIES" || true)
COPIES=$(grep -cE '^frontend/cards/[^/]+\.js\.gz$' <<<"$ENTRIES" || true)
[[ $MODULES -gt 0 && $MODULES -eq $COPIES ]] ||
    die "$FILENAME has $MODULES card modules but $COPIES gzip copies"

log_success "Built $FILENAME for $TAG (version $VERSION)" >&2
echo "$OUTPUT"
